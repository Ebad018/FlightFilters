<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window chrome before Compose draws: midnight enamel, so launch never flashes white. -->
    <style name="Theme.FlightFilters" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/enamel</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
